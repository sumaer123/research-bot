  <in-bse-fin:TradeReceivables contextRef="AsOn31032024" unitRef="INR" decimals="-5">220000.00</in-bse-fin:TradeReceivables>
  <in-bse-fin:CashAndCashEquivalents contextRef="AsOn31032024" unitRef="INR" decimals="-5">150000.00</in-bse-fin:CashAndCashEquivalents>
  <in-bse-fin:Inventories contextRef="AsOn31032024" unitRef="INR" decimals="-5">180000.00</in-bse-fin:Inventories>
  <in-bse-fin:BorrowingsNoncurrent contextRef="AsOn31032024" unitRef="INR" decimals="-5">400000.00</in-bse-fin:BorrowingsNoncurrent>
  <in-bse-fin:ShareCapital contextRef="AsOn31032024" unitRef="INR" decimals="-5">9000.00</in-bse-fin:ShareCapital>
  <in-bse-fin:ReservesAndSurplus contextRef="AsOn31032024" unitRef="INR" decimals="-5">1200000.00</in-bse-fin:ReservesAndSurplus>

