  <in-bse-fin:CashFlowsFromUsedInOperatingActivities contextRef="FourD" unitRef="INR" decimals="-5">210000.00</in-bse-fin:CashFlowsFromUsedInOperatingActivities>
  <in-bse-fin:CashFlowsFromUsedInInvestingActivities contextRef="FourD" unitRef="INR" decimals="-5">-90000.00</in-bse-fin:CashFlowsFromUsedInInvestingActivities>
  <in-bse-fin:CashFlowsFromUsedInFinancingActivities contextRef="FourD" unitRef="INR" decimals="-5">-70000.00</in-bse-fin:CashFlowsFromUsedInFinancingActivities>

  <!-- Auditor + opinion (annual only) -->
  <in-bse-fin:AuditorsFirmName contextRef="FourD">B S R &amp; Co. LLP</in-bse-fin:AuditorsFirmName>
  <in-bse-fin:TypeOfAuditQualification contextRef="FourD">Unmodified opinion</in-bse-fin:TypeOfAuditQualification>

  <!-- Dimensioned segment revenue -->
  <in-bse-fin:SegmentRevenue contextRef="SegAuto" unitRef="INR" decimals="-5">1000000.00</in-bse-fin:SegmentRevenue>
  <in-bse-fin:SegmentRevenue contextRef="SegFin" unitRef="INR" decimals="-5">500000.00</in-bse-fin:SegmentRevenue>

</xbrli:xbrl>
