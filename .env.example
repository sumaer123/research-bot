# Sumaer Research Bot — environment variable NAMES (never commit values).
# Comments live on their own lines on purpose: python-dotenv reads
# `NAME=   # note` as the VALUE "# note", so an inline comment after an empty
# value silently sets it. An empty value means "use the default".

# data directory; default: <project>/data
EQR_DATA_DIR=
# min seconds between requests to the same host
EQR_RATE_LIMIT_S=1.0
# optional socks5h://127.0.0.1:40000 (WARP) for the NSE api on datacenter IPs
EQR_PROXY=
# bearer token for /advisor/v1/* (the advisor API is disabled while unset)
EQR_ADVISOR_TOKEN=
EQR_WEB_HOST=127.0.0.1
EQR_WEB_PORT=8801
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional; otherwise the `claude` CLI on the Mac is used for dossiers
ANTHROPIC_API_KEY=
EQR_CLAUDE_MODEL=claude-opus-5
EQR_RISK_FREE_PCT=6.0

# Parallel free web-research (anonymous Search MCP; no key, no charge). Set to 0 to disable.
EQR_PARALLEL_ENABLED=1
# anonymous MCP endpoint (no auth); the $19.86 sign-up credit is never spent by the app
EQR_PARALLEL_MCP_URL=https://search.parallel.ai/mcp
# hard cap on MCP calls per webresearch run (search + fetch); exceeding it fails soft
EQR_PARALLEL_MAX_CALLS_PER_RUN=8
# comma-separated host allowlist; the empty string means allow all (no client-side filter)
EQR_WEB_ALLOWED_DOMAINS=nseindia.com,bseindia.com,screener.in,moneycontrol.com,economictimes.indiatimes.com,business-standard.com,livemint.com
# drop web results older than this many days (undated results are kept but flagged)
EQR_WEB_LOOKBACK_DAYS=180
# how many top search hits to fetch full text for, per facet
EQR_WEB_FETCH_TOP_K=3
# backup (deploy/backup.sh); RESTIC_REPOSITORY e.g. b2:bucket-name:eqr
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
