# Sumaer Research Bot — environment variable NAMES (never commit values)
EQR_DATA_DIR=            # default: <project>/data
EQR_RATE_LIMIT_S=1.0     # min seconds between requests to the same host
EQR_PROXY=               # optional socks5h://127.0.0.1:40000 (WARP) for NSE api on datacenter IPs
EQR_ADVISOR_TOKEN=       # bearer token for /advisor/v1/*
EQR_WEB_HOST=127.0.0.1
EQR_WEB_PORT=8801
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=       # optional; otherwise `claude` CLI on the Mac is used for dossiers
EQR_CLAUDE_MODEL=claude-opus-5
EQR_RISK_FREE_PCT=6.0
# backup (deploy/backup.sh)
RESTIC_REPOSITORY=       # e.g. b2:bucket-name:eqr
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
