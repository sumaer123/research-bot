{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eqr dossier",
  "type": "object",
  "required": ["symbol", "as_of", "thesis", "rating", "confidence", "bull_case", "bear_case",
               "assessments", "red_flags", "catalysts", "what_would_change_my_mind", "data_gaps", "citations_used"],
  "additionalProperties": false,
  "properties": {
    "symbol": {"type": "string"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "thesis": {"type": "string", "minLength": 80, "maxLength": 1500},
    "rating": {"type": "string", "enum": ["STRONG_BUY", "BUY", "HOLD", "REDUCE", "SELL", "NO_VIEW"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "horizon_months": {"type": "integer", "minimum": 1, "maximum": 36},
    "bull_case": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/claim"}},
    "bear_case": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/claim"}},
    "assessments": {
      "type": "object",
      "required": ["quality", "valuation", "momentum", "governance"],
      "additionalProperties": false,
      "properties": {
        "quality": {"$ref": "#/$defs/assessment"},
        "valuation": {"$ref": "#/$defs/assessment"},
        "momentum": {"$ref": "#/$defs/assessment"},
        "governance": {"$ref": "#/$defs/assessment"}
      }
    },
    "red_flags": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/claim"}},
    "catalysts": {"type": "array", "maxItems": 8, "items": {
      "type": "object", "required": ["event", "expected_by", "direction", "citations"], "additionalProperties": false,
      "properties": {"event": {"type": "string"}, "expected_by": {"type": "string"},
                     "direction": {"type": "string", "enum": ["positive", "negative", "either"]},
                     "quote": {"type": "string", "minLength": 15, "maxLength": 400},
                     "citations": {"type": "array", "items": {"type": "string"}}}}},
    "what_would_change_my_mind": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
    "data_gaps": {"type": "array", "maxItems": 10, "items": {"type": "string"}},
    "citations_used": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "claim": {
      "type": "object", "required": ["claim", "citations"], "additionalProperties": false,
      "properties": {"claim": {"type": "string", "minLength": 10, "maxLength": 600},
                     "quote": {"type": "string", "minLength": 15, "maxLength": 400},
                     "citations": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "assessment": {
      "type": "object", "required": ["score", "summary", "citations"], "additionalProperties": false,
      "properties": {"score": {"type": "integer", "minimum": 1, "maximum": 5},
                     "summary": {"type": "string", "minLength": 20, "maxLength": 800},
                     "quote": {"type": "string", "minLength": 15, "maxLength": 400},
                     "citations": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    }
  }
}
